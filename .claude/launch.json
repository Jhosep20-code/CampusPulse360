{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "campuspulse-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@campuspulse/api",
        "exec",
        "wrangler",
        "dev",
        "--local",
        "--port",
        "8787"
